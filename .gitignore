# Python 编译文件
__pycache__/
*.py[cod]

# 虚拟环境目录（假设你的虚拟环境叫 venv）
venv/
env/

# 本地上传的测试文件（对应我们之前设计的本地存储盘）
media/
uploads/

# Django 本地数据库文件（如果你在本地测试用了 sqlite）
db.sqlite3
backend/db.sqlite3

# Python 测试、类型检查和格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
schema.yaml

# Django 构建输出
backend/staticfiles/

# 环境变量与机密配置
.env
backend/.env
.idea/
.vscode/

# 本地开发文件存储，仅保留目录占位文件
backend/data/files/*
!backend/data/files/.gitkeep
backend/data/temporary/*
!backend/data/temporary/.gitkeep
