# Python 编译文件
__pycache__/
*.py[cod]

# 虚拟环境目录（假设你的虚拟环境叫 venv）
venv/
env/

# 本地上传的测试文件（对应我们之前设计的本地存储盘）
media/
uploads/

# Django 本地数据库文件（如果你在本地测试用了 sqlite）
db.sqlite3
backend/db.sqlite3
backend/test.sqlite3

# Python 测试、类型检查和格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
schema.yaml

# Django 构建输出
backend/staticfiles/

# 环境变量与机密配置
.env
backend/.env
backend/.env.production
backend/data/backups/
.idea/
.vscode/

# 本地开发文件存储，仅保留目录占位文件
backend/data/files/*
!backend/data/files/.gitkeep
backend/data/temporary/*
!backend/data/temporary/.gitkeep

# Document Agent Phase 0 仅提交元数据，不提交历史业务原文
docs/document_agent/phase0/**/*.doc
docs/document_agent/phase0/**/*.docx
docs/document_agent/phase0/**/*.pdf

# Document Agent 私有RAG索引、盲测输入和生成结果不得提交
private-evaluation/
offline-output/
docs/document_agent/phase5/private/

# Codex 本地验证日志和临时渲染工具
.codex_tmp/
