# 用途：本地开发配置模板。复制为 backend/.env 后再填写本机值。
# Django不会读取本文件；development设置实际读取 backend/.env。
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 增加 192.168.1.10:5173以适配局域网测试的情况
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174


# Use a dedicated MySQL user and database in development.
DATABASE_URL=mysql://wind_doc_user:change-me@127.0.0.1:3306/wind_doc_dev
TEST_DATABASE_NAME=wind_doc_test

FILE_STORAGE_ROOT=data/files
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_TIMEOUT_SECONDS=10
TEMPORARY_STORAGE_ROOT=data/temporary

# 系统备份：
# - SYSTEM_BACKUP_LOCAL_ROOT 是开发环境本机备份目录。
# - 第一版不强制 NAS，SYSTEM_BACKUP_OFFSITE_ROOT 默认留空。
# - 如以后挂载了公司共享盘，可再配置该目录并启用自动复制校验。
SYSTEM_BACKUP_LOCAL_ROOT=data/backups
SYSTEM_BACKUP_OFFSITE_ROOT=
SYSTEM_BACKUP_RETENTION_DAYS=30
SYSTEM_BACKUP_MYSQLDUMP_BIN=mysqldump
SYSTEM_BACKUP_MYSQL_BIN=mysql
MAX_UPLOAD_SIZE_MB=200
TEMPORARY_GRANT_DEFAULT_HOURS=24
TEMPORARY_GRANT_MAX_HOURS=168
TEMPORARY_GRANT_MAX_DOWNLOADS=20
# Independent WebAuthn switches. Use false/true for password login plus verified locations.
LOGIN_REQUIRE_WEBAUTHN=true
LOCATION_REPORT_REQUIRE_WEBAUTHN=true
API_ENFORCE_PASSWORD_CHANGE=true
LOGIN_THROTTLE_IP_RATE=20/min
LOGIN_THROTTLE_ACCOUNT_RATE=5/min
TRUST_PROXY_HEADERS=false
USE_X_ACCEL_REDIRECT=false
X_ACCEL_REDIRECT_PREFIX=/protected-files/
ENABLE_DJANGO_ADMIN=true
ENABLE_API_DOCS=true
VALIDATE_UPLOAD_FILE_SIGNATURES=true
DJANGO_SECURE_HSTS_SECONDS=0

# WebAuthn 本人验证。本地必须用 http://localhost:5174 访问前端，不能混用 127.0.0.1。
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=绿能信盾资料管理系统
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5174
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
WEBAUTHN_ENROLLMENT_TICKET_TTL_SECONDS=1800
# iPhone/Android 平台通行密钥通常可同步；仍会强制用户验证、挑战和 RP/来源校验。
WEBAUTHN_ALLOW_SYNCED_PASSKEYS=true

# Document Agent Phase 3：真实值只写本地 .env，不得提交Git。
# OpenAI兼容根路径示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_WAIT_SECONDS=0.5

# Document Agent Phase 4：生产使用业务空间专属HTTPS兼容地址。
# OpenAI兼容根路径示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=3
LLM_RETRY_WAIT_SECONDS=0.5
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Document Agent Phase 6–8：Phase 5真实评测通过前必须保持false。
DOCUMENT_AGENT_ENABLED=false
DOCUMENT_AGENT_PHASE5_APPROVED=false
DOCUMENT_AGENT_ALLOW_FAKE_PROVIDER=false
REDIS_URL=redis://127.0.0.1:6379/0
DOCUMENT_AGENT_JOB_TIMEOUT_SECONDS=1800
DOCUMENT_AGENT_STALE_TASK_SECONDS=2100
